# Server Configuration
PORT=
NODE_ENV=

# Security & Authentication Secrets
JWT_SECRET=your_jwt_secret_key
# PASSWORD_SALT=your_custom_salt_string

# Database
MONGODB_URI=your_mongodb_connection_string

# Gemini AI (Optional - for AI pitch review)
GEMINI_API_KEY=your_gemini_api_key

# Admin & User Credentials (Set these in your Netlify site environment variables)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password
USER_PASSWORD=your_user_password

# Client API Base URL (leave empty for same-domain Netlify Functions or set to external API URL)
VITE_API_URL=
